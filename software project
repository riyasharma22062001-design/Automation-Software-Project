@app.route("/items")
def items():
    search_term = request.args.get("q", "").strip()
    status_filter = request.args.get("status", "").strip()

    with get_db() as db:
        sql = """
            SELECT items.*, users.name AS reporter
            FROM items
            JOIN users ON items.user_id = users.id
            WHERE 1=1
        """
        parameters = []

        if search_term:
            sql += """
                AND (
                    items.title LIKE ?
                    OR items.category LIKE ?
                    OR items.location LIKE ?
                )
            """
            parameters.extend([
                f"%{search_term}%",
                f"%{search_term}%",
                f"%{search_term}%",
            ])

        if status_filter in ("Lost", "Found"):
            sql += " AND items.status = ?"
            parameters.append(status_filter)

        sql += " ORDER BY items.id DESC"

        results = db.execute(sql, parameters).fetchall()

    body = """
    <section class="card">
        <h1>Search Lost and Found Items</h1>
        <form method="GET" action="/items">
            <label for="q">Search by title, category or location</label>
            <input id="q" name="q" value="{{ search_term }}"
                   placeholder="Enter item name or location">

            <label for="status">Filter by status</label>
            <select id="status" name="status">
                <option value="">All Items</option>
                <option value="Lost" {% if status_filter == 'Lost' %}selected{% endif %}>Lost</option>
                <option value="Found" {% if status_filter == 'Found' %}selected{% endif %}>Found</option>
            </select>

            <button type="submit">Search</button>
        </form>

        <p class="small">Results: {{ results|length }}</p>

        {% if results %}
            {% for item in results %}
            <article class="card item-result">
                <h2>{{ item['title'] }}</h2>
                <p><strong>Category:</strong> {{ item['category'] }}</p>
                <p><strong>Description:</strong> {{ item['description'] }}</p>
                <p><strong>Location:</strong> {{ item['location'] }}</p>
                <p><strong>Status:</strong> {{ item['status'] }}</p>
                <p><strong>Reported by:</strong> {{ item['reporter'] }}</p>
            </article>
            {% endfor %}
        {% else %}
            <p id="no-results">No matching items found.</p>
        {% endif %}
    </section>
    """
    return render_page(
        "Search Items",
        body,
        search_term=search_term,
        status_filter=status_filter,
        results=results,
    )


