# CROSS-BROWSER TESTING
# ============================================================

def run_cross_browser_tests(playwright):
    browser_types = {
        "chromium": playwright.chromium,
        "firefox": playwright.firefox,
        "webkit": playwright.webkit,
    }

    for browser_name in BROWSER_NAMES:
        browser_type = browser_types[browser_name]

        print("\n" + "#" * 78)
        print(f"CROSS-BROWSER TESTING: {browser_name.upper()}")
        print("#" * 78)

        try:
            run_browser_tests(browser_name, browser_type)

        except Exception as error:
            # A missing browser installation should not hide results from
            # the other browsers. Mark this browser as unavailable.
            message = f"{type(error).__name__}: {str(error).splitlines()[0]}"
            print(f"[SKIP] Could not run {browser_name}: {message}")
            print(
                "Install browser binaries using: "
                "python -m playwright install chromium firefox webkit"
            )

            ALL_RESULTS.append({
                "browser": browser_name,
                "test_id": "BROWSER-SETUP",
                "test_name": f"{browser_name} browser setup",
                "expected": "Browser launches and functional tests execute.",
                "actual": message,
                "final": "Browser suite could not be completed.",
                "status": "SKIP",
            })


# ============================================================
# RESPONSIVE SMOKE TEST
# ============================================================

def run_responsive_tests(playwright):
    print("\n" + "=" * 78)
    print("RESPONSIVE UI SMOKE TESTS (CHROMIUM)")
    print("=" * 78)

    browser = playwright.chromium.launch(headless=False, slow_mo=250)
    context = browser.new_context()
    page = context.new_page()

    try:
        viewports = [
            ("Desktop", 1366, 768),
            ("Tablet", 768, 1024),
            ("Mobile", 390, 844),
        ]

        for name, width, height in viewports:
            def viewport_test():
                page.set_viewport_size({"width": width, "height": height})
                page.goto(BASE_URL)
                expect(page.get_by_role(
                    "heading", name="Welcome to FindIt Portal"
                )).to_be_visible()

                # Basic horizontal-overflow check.
                dimensions = page.evaluate(
                    """() => ({
                        pageWidth: document.documentElement.scrollWidth,
                        viewportWidth: document.documentElement.clientWidth
                    })"""
                )
                assert dimensions["pageWidth"] <= dimensions["viewportWidth"], (
                    f"Horizontal overflow: {dimensions}"
                )
                return f"{width}x{height}: heading visible; no horizontal overflow."

            record_result(
                "chromium", f"RT-{name.upper()}",
                f"Responsive layout - {name}",
                f"Page fits a {width}x{height} viewport without horizontal overflow.",
                viewport_test,
            )
    finally:
        context.close()
        browser.close()


