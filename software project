def show_final_lost_items(playwright):
    print("\n" + "=" * 78)
    print("FINAL SCREEN: ALL REPORTED LOST ITEMS")
    print("=" * 78)

    browser = playwright.chromium.launch(headless=False, slow_mo=200)
    page = browser.new_page(viewport={"width": 1366, "height": 850})

    try:
        page.goto(BASE_URL + "/items?status=Lost")
        expect(page.get_by_role(
            "heading", name="Search Lost and Found Items"
        )).to_be_visible()

        articles = page.locator("article.item-result")
        count = articles.count()
        print(f"Total reported Lost items: {count}\n")

        for index in range(count):
            article = articles.nth(index)
            title = article.locator("h2").inner_text()
            paragraphs = article.locator("p").all_inner_texts()

            print(f"{index + 1}. {title}")
            for paragraph in paragraphs:
                print("   " + paragraph)
            print("-" * 60)

        print(f"\nThe browser will remain open for {FINAL_PAGE_SECONDS} seconds.")
        page.wait_for_timeout(FINAL_PAGE_SECONDS * 1000)

    finally:
        browser.close()


