ALL_RESULTS = []


def record_result(browser_name, test_id, test_name, expected, function):
    print(f"\n[{browser_name.upper()}] {test_id}: {test_name}")
    print("Expected result:", expected)

    try:
        actual = function()
        actual_text = str(actual or "Test assertions completed successfully")
        passed = True
        final_result = "Expected behavior observed"
    except Exception as error:
        passed = False
        actual_text = f"{type(error).__name__}: {str(error).splitlines()[0]}"
        final_result = "Expected behavior not confirmed"

    status = "PASS" if passed else "FAIL"

    row = {
        "browser": browser_name,
        "test_id": test_id,
        "test_name": test_name,
        "expected": expected,
        "actual": actual_text,
        "final": final_result,
        "status": status,
    }
    ALL_RESULTS.append(row)

    print("Actual result:", actual_text)
    print("Final result:", final_result)
    print("Status:", status)

    return passed


