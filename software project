# FINAL REPORT
# ============================================================

def print_final_report():
    print("\n" + "=" * 110)
    print("FINAL AUTOMATION TEST REPORT")
    print("=" * 110)

    headers = (
        "Browser", "Test ID", "Test Name", "Expected Result",
        "Actual Result", "Final Result", "Status"
    )

    for result in ALL_RESULTS:
        print("-" * 110)
        for heading, key in zip(
            headers,
            ("browser", "test_id", "test_name", "expected",
             "actual", "final", "status"),
        ):
            print(f"{heading}: {result[key]}")

    passed = sum(r["status"] == "PASS" for r in ALL_RESULTS)
    failed = sum(r["status"] == "FAIL" for r in ALL_RESULTS)
    skipped = sum(r["status"] == "SKIP" for r in ALL_RESULTS)

    print("\n" + "=" * 78)
    print("SUMMARY")
    print("=" * 78)
    print("Total recorded results:", len(ALL_RESULTS))
    print("Passed:", passed)
    print("Failed:", failed)
    print("Skipped:", skipped)

    if failed == 0 and skipped == 0:
        print("All recorded tests passed.")
    elif failed:
        print("Some tests failed. Review the actual results above.")
    else:
        print("Some browser tests were skipped. Check browser installation.")


