            expect(page.get_by_role(
                "cell", name=found_title, exact=True
            )).to_be_visible()
            return "Found item was saved and displayed."

        record_result(
            browser_name, "FT-08", "Report a Found item",
            "Found item is saved with Found status.",
            report_found_test
        )

        # TEST 9 - No search results
        def no_results_test():
